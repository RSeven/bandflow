<% content_for :title, "#{t("rehearsals.show.title")} — #{@music.title}" %>

<div data-controller="presentation"
     data-presentation-music-count-value="1"
     data-presentation-tap-to-pause-value="<%= t("presentation.tap_to_pause") %>"
     data-presentation-tap-to-resume-value="<%= t("presentation.tap_to_resume") %>"
     class="flex flex-col h-[100dvh] overflow-hidden bg-zinc-950">

  <div class="flex-none bg-zinc-900 border-b border-zinc-800 px-4 py-2 flex items-center gap-3 min-w-0">
    <button data-action="click->presentation#toggleTimer"
            data-presentation-target="timerBtn"
            class="flex items-baseline gap-1.5 flex-shrink-0">
      <span data-presentation-target="timer"
            class="text-xl font-mono font-bold text-amber-400 tabular-nums">00:00</span>
      <span class="text-zinc-600 text-xs"><%= t("presentation.tap_to_pause") %></span>
    </button>

    <div class="min-w-0 flex-1 text-center">
      <div class="text-sm font-semibold truncate"><%= @music.title %></div>
      <div class="text-xs text-zinc-500 truncate"><%= @music.artist %></div>
    </div>

    <div class="text-right flex-shrink-0">
      <span data-presentation-target="counter"
            class="text-lg font-bold tabular-nums text-zinc-300">1/1</span>
      <div class="text-zinc-600 text-xs"><%= t("presentation.song") %></div>
    </div>

    <button data-action="click->presentation#toggleHeader"
            data-presentation-target="headerToggle"
            class="flex-none flex flex-col items-center gap-0.5 text-zinc-400 hover:text-zinc-100 active:text-zinc-100 transition-colors p-1 -mr-1 select-none"
            aria-label="<%= t('presentation.controls') %>">
      <svg data-presentation-target="headerChevron"
           xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
           class="w-4 h-4 transition-transform duration-200">
        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
      </svg>
      <span class="text-[10px] uppercase tracking-wide font-semibold leading-none"><%= t("presentation.controls") %></span>
    </button>
  </div>

  <div data-presentation-target="headerPanel"
       class="flex-none bg-zinc-900 border-b border-zinc-800 overflow-hidden"
       style="max-height: 0; transition: max-height 0.2s ease;">
    <div class="px-4 pt-3 pb-1">
      <div class="text-zinc-500 text-xs uppercase tracking-wide"><%= t("rehearsals.show.mode") %></div>
      <div class="text-lg font-bold truncate"><%= @music.title %></div>
      <div class="text-zinc-400 text-sm truncate"><%= @band.name %></div>
      <div class="text-xs mt-2 <%= @music.rehearsed? ? "text-zinc-500" : "text-amber-400" %>">
        <% if @music.rehearsed? %>
          <%= t("rehearsals.show.last_rehearsed", time: l(@music.last_rehearsed_at, format: :long)) %>
        <% else %>
          <%= t("rehearsals.show.never_rehearsed") %>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-3 px-4 pb-3 pt-2">
      <%= link_to band_rehearsal_path(@band),
          class: "flex-none bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-xl px-4 py-3 text-sm font-semibold text-zinc-300 hover:text-zinc-100 transition-colors" do %>
        <%= t("presentation.exit") %>
      <% end %>

      <%= button_to t("rehearsals.show.mark_rehearsed"), band_rehearsal_music_path(@band, @music),
          method: :patch,
          params: { mark_now: "1", return_to: "show" },
          form_class: "flex-1",
          class: "w-full bg-amber-500 hover:bg-amber-400 active:bg-amber-300 text-black rounded-xl px-5 py-3 text-sm font-bold transition-colors select-none cursor-pointer" %>

      <button data-action="click->presentation#next"
              data-presentation-target="nextBtn"
              class="hidden">
        <%= t("common.next") %>
      </button>
    </div>
  </div>

  <template data-presentation-target="item"
            data-type="music"
            data-music-index="1">
    <div class="px-6 py-4">
      <div class="flex items-center gap-3 mb-4 pb-3 border-b border-zinc-800 min-w-0">
        <div class="min-w-0">
          <h2 class="text-lg font-bold leading-tight break-all"><%= @music.title %></h2>
          <p class="text-zinc-400 text-sm break-all"><%= @music.artist %></p>
        </div>
        <div class="ml-auto flex gap-2 text-xs flex-shrink-0">
          <% if @music.bpm.present? %>
            <span class="bg-zinc-800 px-2 py-1 rounded"><%= @music.bpm_display %> BPM</span>
          <% end %>
          <% if @music.key_name.present? %>
            <span class="bg-zinc-800 px-2 py-1 rounded"><%= @music.musical_key %></span>
          <% end %>
        </div>
      </div>
      <% if @music.has_chords? && @music.lyrics.present? %>
        <div class="mb-4 flex gap-2">
          <button type="button"
                  data-action="click->presentation#showChords"
                  data-presentation-view="chords"
                  class="flex-1 rounded-lg border border-amber-500/40 bg-amber-500/20 px-3 py-2.5 text-sm font-semibold text-amber-300 transition-colors">
            <%= t("musics.show.chords") %>
          </button>
          <button type="button"
                  data-action="click->presentation#showLyrics"
                  data-presentation-view="lyrics"
                  class="flex-1 rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2.5 text-sm font-semibold text-zinc-300 transition-colors">
            <%= t("musics.show.lyrics") %>
          </button>
        </div>

        <pre data-presentation-content="chords"
             class="font-mono text-base leading-relaxed whitespace-pre-wrap text-zinc-100"><%= @music.chords %></pre>
        <pre data-presentation-content="lyrics"
             class="hidden text-base leading-relaxed whitespace-pre-wrap text-zinc-100"><%= @music.lyrics %></pre>
      <% elsif @music.has_chords? %>
        <pre class="font-mono text-base leading-relaxed whitespace-pre-wrap text-zinc-100"><%= @music.chords %></pre>
      <% elsif @music.lyrics.present? %>
        <pre class="text-base leading-relaxed whitespace-pre-wrap text-zinc-100"><%= @music.lyrics %></pre>
      <% else %>
        <p class="text-zinc-500 text-sm italic"><%= t("presentation.no_content") %></p>
      <% end %>
    </div>
  </template>

  <div class="relative flex-1 overflow-hidden">
    <div data-presentation-target="scrollMarker"
         class="pointer-events-none absolute left-0 right-0 z-20 hidden px-4"
         style="top: 0;">
      <div class="flex items-center gap-2">
        <div class="h-0.5 flex-1 rounded-full bg-amber-400"></div>
        <span class="rounded-full border border-amber-500/40 bg-zinc-950/90 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-300">
          <%= t("presentation.next_stop") %>
        </span>
        <div class="h-0.5 flex-1 rounded-full bg-amber-400"></div>
      </div>
    </div>

    <div data-presentation-target="contentArea"
         class="h-full overflow-y-auto scroll-smooth"
         style="scroll-behavior: smooth;">
      <div data-presentation-target="content" class="min-h-full"></div>
    </div>
  </div>

  <div class="flex-none bg-zinc-900 border-t border-zinc-800 flex"
       style="min-height: 12vh; padding-bottom: env(safe-area-inset-bottom);">
    <button data-action="click->presentation#scrollUp"
            class="flex-1 bg-zinc-900 hover:bg-zinc-800 active:bg-zinc-600 text-zinc-100 transition-colors select-none"
            style="border-right: 1px solid rgb(39 39 42);">
      <div class="flex flex-col items-center justify-center h-full px-4 text-center">
        <div class="text-xl font-bold leading-none">↑</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wide text-zinc-300"><%= t("presentation.scroll_up") %></div>
      </div>
    </button>

    <button data-action="click->presentation#scrollDown"
            class="flex-1 bg-amber-500 hover:bg-amber-400 active:bg-amber-300 text-black transition-colors select-none">
      <div class="flex flex-col items-center justify-center h-full px-4 text-center">
        <div class="text-xl font-bold leading-none">↓</div>
        <div class="mt-1 text-xs font-semibold uppercase tracking-wide"><%= t("presentation.scroll_down") %></div>
      </div>
    </button>
  </div>
</div>
